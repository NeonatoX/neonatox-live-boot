#!/bin/sh
PATH=/sbin:/bin:/usr/bin:/usr/sbin
[ "$debug" = "1" ] && set -x

. /lib/init-common.sh

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true

show_banner

CMDLINE="$(cat /proc/cmdline)"

# Precedencia de MODE (contrato §5.2.6/P0b):
#   1. netinstall=1 (cmdline explícito) — pisa cualquier marcador
#   2. marcador /etc/neonatox-mode   (sysroot embedded horneado en build)
#   3. root= (cualquier forma: /dev/, UUID=, PARTUUID=, LABEL=) — SOLO sin
#      marcador → disk (initramfs clásico)
#   4. live (default)
MODE="live"
if [ -f /etc/neonatox-mode ]; then
    MODE="$(cat /etc/neonatox-mode 2>/dev/null)"
    [ -n "$MODE" ] || MODE="live"
fi
case " $CMDLINE " in
    *" netinstall=1 "*) MODE="netinstall" ;;
    *)
        [ ! -f /etc/neonatox-mode ] && case " $CMDLINE " in
            *" root="*) MODE="disk" ;;
        esac
        ;;
esac

case "$MODE" in
    live)       . /lib/init-live.sh ;;
    netinstall) . /lib/init-live.sh; . /lib/init-net.sh ;;
    disk)       . /lib/init-disk.sh ;;
    embedded)   . /lib/init-embedded.sh ;;
esac

for phase in /libexec/[0-9][0-9]-*; do
    [ -f "$phase" ] || continue
    PHASE="${phase##*/}"
    . "$phase" "$MODE" || emergency_shell "Phase $PHASE failed"
done
